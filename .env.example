# Copy to .env for the real Teams / Bedrock integration.
TEAMS_HMAC_SECRET=REPLACE_WITH_BASE64_TOKEN_FROM_OUTGOING_WEBHOOK
TEAMS_TENANT_ID=REPLACE_WITH_TENANT_ID
# channelData.team.id is a Teams thread ID, not necessarily the Entra group GUID.
TEAMS_TEAM_ID=REPLACE_WITH_TEAMS_TEAM_THREAD_ID
TEAMS_CHANNEL_ID=REPLACE_WITH_CHANNEL_THREAD_ID
# Workflows trigger: When a Teams webhook request is received, auth = Anyone.
# Treat the whole URL (including its signature) as a password.
TEAMS_WORKFLOW_URL=https://REPLACE_WITH_WORKFLOW_URL
REDIS_URL=redis://localhost:6379/0
AGENT_BACKEND=bedrock
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
# Local Poetry runs may use AWS_PROFILE. Containers can use temporary credentials:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
